<Project Sdk="Microsoft.NET.Sdk">

  
  <PropertyGroup>
    <Version>1.4.8</Version>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AssemblyVersion>1.4.8.0</AssemblyVersion>
    <FileVersion>1.4.8.0</FileVersion>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationIcon>..\assets\GalaxyBatteryCheck.ico</ApplicationIcon>
    <AssemblyName>GalaxyBatteryCheck</AssemblyName>
    <RootNamespace>GalaxyBatteryCheck.Gui</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\GalaxyBatteryCheck.Core\GalaxyBatteryCheck.Core.csproj" />
  </ItemGroup>

  
  <ItemGroup>
    <None Include="..\assets\GalaxyBatteryCheck.ico" Link="GalaxyBatteryCheck.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />

  </ItemGroup>

</Project>
